<Window x:Class="DualTune.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DualTune.App.Localization"
        xmlns:views="clr-namespace:DualTune.App.Views"
        xmlns:guide="clr-namespace:DualTune.App.Guide"
        Title="Vectra" Icon="Assets/vectra.ico" Width="1180" Height="800" MinWidth="900" MinHeight="600"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Border DockPanel.Dock="Top" Height="4" Background="{StaticResource Red}" />

        <TabControl Style="{StaticResource NavTabs}">
            <TabControl.Tag>
                <StackPanel Margin="16,0,16,16">
                    <Button Style="{StaticResource SkewButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,20"
                            Command="{Binding OpenGuideCommand}" ToolTip="{l:Tr main.guideTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" FontFamily="{StaticResource Glyphs}" FontStyle="Normal" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{l:Tr main.guide}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SkewButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,-12,0,20"
                            BorderBrush="{StaticResource Red}" Command="{Binding OpenUrlCommand}" CommandParameter="release"
                            ToolTip="{l:Tr update.tip}"
                            Visibility="{Binding UpdateAvailable, Converter={x:Static guide:BoolVisibility.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Glyphs}" FontStyle="Normal" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource Red}" />
                            <TextBlock Text="{l:Tr update.button}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UpdateVersion}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <views:ProfilesPanel Margin="0,0,0,22" />
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Style="{StaticResource Dot}" Tag="{Binding ControllerOk}" />
                        <TextBlock Style="{StaticResource StatusLine}" Text="{Binding ControllerStatus}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Style="{StaticResource Dot}" Tag="{Binding ViGEmOk, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource StatusLine}" Text="{Binding ViGEmStatus, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <Ellipse Style="{StaticResource Dot}" Tag="{Binding HidHideOk}" />
                        <TextBlock Style="{StaticResource StatusLine}" Text="{Binding HidHideStatus}" />
                    </StackPanel>
                </StackPanel>
            </TabControl.Tag>

            <TabItem Header="{l:Tr tab.sticks}" Tag="&#xE7FC;">
                <views:SticksView />
            </TabItem>
            <TabItem Header="{l:Tr tab.curves}" Tag="&#xE9D2;">
                <views:CurvesView />
            </TabItem>
            <TabItem Header="{l:Tr tab.triggers}" Tag="&#xE74B;">
                <views:TriggersView />
            </TabItem>
            <TabItem Header="{l:Tr tab.buttons}" Tag="&#xE91F;">
                <views:ButtonsView />
            </TabItem>
            <TabItem Header="{l:Tr tab.settings}" Tag="&#xE713;">
                <views:SettingsView />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
