<UserControl x:Class="DualTune.App.Views.TriggersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DualTune.App.Localization"
             xmlns:c="clr-namespace:DualTune.App.Controls"
             xmlns:theme="clr-namespace:DualTune.App.Theme"
             xmlns:vm="clr-namespace:DualTune.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="TriggerPanel" DataType="{x:Type vm:TriggerViewModel}">
            <Expander Style="{StaticResource Section}" Header="{Binding Title}" theme:Racing.Summary="{Binding Summary}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" MinWidth="260" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="16" />
                        <RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="36" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource Label}" Text="{l:Tr triggers.raw}" />
                    <c:SegmentSlider Grid.Column="1" IsReadOnly="True" Minimum="0" Maximum="1" Height="14" Accent="{StaticResource Muted}" Value="{Binding RawValue, Mode=OneWay}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding RawValue, StringFormat={}{0:P0}}" />

                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{l:Tr triggers.output}" />
                    <c:SegmentSlider Grid.Row="1" Grid.Column="1" IsReadOnly="True" Minimum="0" Maximum="1" Height="14" Accent="{StaticResource Red}" Value="{Binding OutputValue, Mode=OneWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding OutputValue, StringFormat={}{0:P0}}" />

                    <Border Grid.Row="2" Grid.ColumnSpan="3" Height="1" Background="{StaticResource Line}" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="{l:Tr triggers.deadzone}" />
                    <c:SegmentSlider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="0.5" SmallChange="0.005" Value="{Binding InnerDeadzone}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding InnerDeadzone, StringFormat={}{0:P1}}" />

                    <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="{l:Tr triggers.outer}" />
                    <c:SegmentSlider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="0.5" SmallChange="0.005" Value="{Binding OuterDeadzone}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding OuterDeadzone, StringFormat={}{0:P1}}" />

                    <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="{l:Tr common.antiDeadzone}" />
                    <c:SegmentSlider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="0.5" SmallChange="0.005" Accent="{StaticResource Red}" Value="{Binding AntiDeadzone}" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding AntiDeadzone, StringFormat={}{0:P1}}" />

                    <Button Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0"
                            Style="{StaticResource SkewButton}" Content="{l:Tr common.reset}" Command="{Binding ResetCommand}" />
                </Grid>
            </Expander>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <ContentControl Content="{Binding L2}" ContentTemplate="{StaticResource TriggerPanel}" Focusable="False" />
            <ContentControl Content="{Binding R2}" ContentTemplate="{StaticResource TriggerPanel}" Focusable="False" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
