<UserControl x:Class="DualTune.App.Views.CurvesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DualTune.App.Localization"
             xmlns:c="clr-namespace:DualTune.App.Controls"
             xmlns:vm="clr-namespace:DualTune.App.ViewModels">
    <DockPanel DataContext="{Binding Curves}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-44,0,14">
            <RadioButton Style="{StaticResource SkewToggle}" Content="{l:Tr curves.leftStick}" GroupName="target" IsChecked="{Binding IsLeft}" />
            <RadioButton Style="{StaticResource SkewToggle}" Content="{l:Tr curves.rightStick}" GroupName="target" IsChecked="{Binding IsRight}" />
            <RadioButton Style="{StaticResource SkewToggle}" Content="L2" GroupName="target" IsChecked="{Binding IsL2}" />
            <RadioButton Style="{StaticResource SkewToggle}" Content="R2" GroupName="target" IsChecked="{Binding IsR2}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Expander Style="{StaticResource Section}" Header="{l:Tr curves.title}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <c:CurveEditor Width="440" Height="440" Curve="{Binding Curve}" CurrentInput="{Binding CurrentInput}" />

                        <StackPanel Grid.Column="2" MaxWidth="260" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Label}" Text="{l:Tr curves.presets}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{x:Static vm:CurvesViewModel.Presets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SkewButton}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                                Content="{Binding Label, Converter={x:Static vm:UpperCase.Instance}}"
                                                Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Name}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource Label}" Text="{l:Tr curves.usage}" Margin="0,22,0,8" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr curves.help}" />
                        </StackPanel>
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
