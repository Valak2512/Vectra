<UserControl x:Class="DualTune.App.Views.ButtonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DualTune.App.Localization"
             xmlns:vm="clr-namespace:DualTune.App.ViewModels">
    <DockPanel DataContext="{Binding Buttons}">
        <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,-44,0,14" Style="{StaticResource SkewButton}"
                Content="{l:Tr buttons.reset}" Command="{Binding ResetCommand}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                           Text="{l:Tr buttons.hint}" />
                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ButtonGroup}">
                            <Expander Style="{StaticResource Section}" Header="{Binding Title}">
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ButtonRow}">
                                            <DockPanel Margin="0,0,24,8" Height="28">
                                                <Rectangle x:Name="led" DockPanel.Dock="Left" Width="8" Height="8" Fill="{StaticResource Off}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <ComboBox DockPanel.Dock="Right" Width="190"
                                                          ItemsSource="{x:Static vm:ButtonsViewModel.Targets}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                                          SelectedValue="{Binding Target}" />
                                                <TextBlock x:Name="lbl" Text="{Binding Label, Converter={x:Static vm:UpperCase.Instance}}" Style="{StaticResource Label}" FontSize="12" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                    <Setter TargetName="led" Property="Fill" Value="{StaticResource Ok}" />
                                                    <Setter TargetName="lbl" Property="Foreground" Value="{StaticResource Text}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
