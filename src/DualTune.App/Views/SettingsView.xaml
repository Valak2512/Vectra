<UserControl x:Class="DualTune.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DualTune.App.Localization">
    <UserControl.Resources>
        <Style x:Key="Link" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="TextDecorations" Value="None" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <StackPanel>
            <Expander Style="{StaticResource Section}" Header="{l:Tr settings.language}">
                <WrapPanel DataContext="{x:Static l:Loc.Instance}">
                    <RadioButton Style="{StaticResource SkewToggle}" Content="FRANÇAIS" GroupName="lang" IsChecked="{Binding IsFrench}" />
                    <RadioButton Style="{StaticResource SkewToggle}" Content="ENGLISH" GroupName="lang" IsChecked="{Binding IsEnglish}" />
                </WrapPanel>
            </Expander>

            <Expander Style="{StaticResource Section}" Header="{l:Tr settings.output}">
                <StackPanel>
                    <CheckBox Style="{StaticResource Switch}" Content="{l:Tr settings.virtualPad}" IsChecked="{Binding OutputEnabled}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="52,0,0,10" Text="{l:Tr settings.virtualPadHint}" />
                    <CheckBox Style="{StaticResource Switch}" Content="{l:Tr settings.hide}" IsChecked="{Binding HideController}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="52,0,0,10" Text="{l:Tr settings.hideHint}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0">
                        <Run Text="{l:Tr settings.drivers}" />
                        <Hyperlink Style="{StaticResource Link}" NavigateUri="https://github.com/nefarius/ViGEmBus/releases" RequestNavigate="OnLink">ViGEmBus</Hyperlink>
                        <Run Text="{l:Tr settings.and}" />
                        <Hyperlink Style="{StaticResource Link}" NavigateUri="https://github.com/nefarius/HidHide/releases" RequestNavigate="OnLink">HidHide</Hyperlink>.
                    </TextBlock>
                </StackPanel>
            </Expander>

            <Expander Style="{StaticResource Section}" Header="{l:Tr settings.diagnostic}">
                <StackPanel>
                    <CheckBox Style="{StaticResource Switch}" Content="{l:Tr settings.capture}" IsChecked="{Binding CaptureMode}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="52,0,0,10"
                               Text="{l:Tr settings.captureHint}" />
                    <TextBox Text="{Binding RawHex, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="13"
                             Padding="10" MinHeight="120" BorderThickness="0" />
                </StackPanel>
            </Expander>

            <Expander Style="{StaticResource Section}" Header="{l:Tr about.title}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" FontSize="15" Foreground="{StaticResource Text}" Margin="0,0,0,10">
                        <Run Text="VECTRA" /> <Run Text="{Binding AppVersion, Mode=OneWay}" />
                    </TextBlock>
                    <CheckBox Style="{StaticResource Switch}" Content="{l:Tr about.checkUpdates}" IsChecked="{Binding CheckUpdates}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="52,0,0,10" Text="{l:Tr about.checkUpdatesHint}" />
                    <WrapPanel Margin="0,4,0,10">
                        <Button Style="{StaticResource SkewButton}" Content="{l:Tr about.github}" Command="{Binding OpenUrlCommand}" CommandParameter="repo" />
                        <Button Style="{StaticResource SkewButton}" Content="{l:Tr about.license}" Command="{Binding OpenUrlCommand}" CommandParameter="license" />
                        <Button Style="{StaticResource SkewButton}" Content="{l:Tr about.notices}" Command="{Binding OpenUrlCommand}" CommandParameter="notices" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="{l:Tr about.disclaimer}" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
