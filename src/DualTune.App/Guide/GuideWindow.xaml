<Window x:Class="DualTune.App.Guide.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:g="clr-namespace:DualTune.App.Guide"
        xmlns:l="clr-namespace:DualTune.App.Localization"
        Title="{l:Tr guide.windowTitle}" Icon="/Assets/vectra.ico"
        Width="820" Height="560" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Voyant d'une ligne de test : vert si la propriété liée (Tag) est vraie. -->
        <Style x:Key="CheckDot" TargetType="Rectangle">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource Off}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource Ok}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="CheckLine" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Height="4" Background="{StaticResource Red}" />

        <!-- Étapes -->
        <Border DockPanel.Dock="Left" Width="210" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,18,0,0">
                <TextBlock Text="{l:Tr main.guide}" Style="{StaticResource Title}" Margin="18,0,0,16" />
                <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type g:GuideStep}">
                            <Border x:Name="row" Padding="18,8">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle x:Name="dot" Width="8" Height="8" Fill="{StaticResource Off}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="title" Text="{Binding Title}" Style="{StaticResource Label}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Ok">
                                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource Ok}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Warn">
                                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource Warn}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="{StaticResource Text}" />
                                    <Setter TargetName="title" Property="Foreground" Value="{StaticResource Bg}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Navigation -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource SkewButton}" Content="{l:Tr guide.back}" Command="{Binding BackCommand}" Margin="0"
                        Visibility="{Binding Current, Converter={x:Static g:StepVisibility.Instance}, ConverterParameter=!0}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SkewButton}" Content="{Binding NextLabel}" Command="{Binding NextCommand}" Margin="0"
                            Visibility="{Binding IsLast, Converter={x:Static g:BoolVisibility.Instance}, ConverterParameter=invert}" />
                    <Button Style="{StaticResource SkewButton}" Content="{l:Tr guide.finish}" Command="{Binding FinishCommand}" Margin="0"
                            Visibility="{Binding IsLast, Converter={x:Static g:BoolVisibility.Instance}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Contenu de l'étape -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,20,28,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <Border DockPanel.Dock="Right" Padding="10,3" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Off}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep.Status}" Value="Ok">
                                        <Setter Property="Background" Value="{StaticResource Ok}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep.Status}" Value="Warn">
                                        <Setter Property="Background" Value="{StaticResource Warn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontStyle="Oblique" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{l:Tr guide.todo}" />
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep.Status}" Value="Ok">
                                            <Setter Property="Text" Value="OK" />
                                            <Setter Property="Foreground" Value="{StaticResource Bg}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep.Status}" Value="Warn">
                                            <Setter Property="Text" Value="{l:Tr guide.warn}" />
                                            <Setter Property="Foreground" Value="{StaticResource Bg}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding CurrentStep.Title}" Style="{StaticResource Title}" />
                </DockPanel>

                <!-- 0 BIENVENUE -->
                <StackPanel Visibility="{Binding Current, Converter={x:Static g:StepVisibility.Instance}, ConverterParameter=0}">
                    <TextBlock Style="{StaticResource Label}" Text="LANGUE · LANGUAGE" Margin="0,0,0,6" />
                    <WrapPanel DataContext="{x:Static l:Loc.Instance}" Margin="0,0,0,18">
                        <RadioButton Style="{StaticResource SkewToggle}" Content="FRANÇAIS" GroupName="guideLang" IsChecked="{Binding IsFrench}" />
                        <RadioButton Style="{StaticResource SkewToggle}" Content="ENGLISH" GroupName="guideLang" IsChecked="{Binding IsEnglish}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{l:Tr guide.welcome1}" />
                    <TextBlock Style="{StaticResource Body}" Text="{l:Tr guide.welcome2}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{l:Tr guide.welcome3}" />
                </StackPanel>

                <!-- 1 VIGEMBUS -->
                <StackPanel Visibility="{Binding Current, Converter={x:Static g:StepVisibility.Instance}, ConverterParameter=1}">
                    <TextBlock Style="{StaticResource Body}" Text="{l:Tr guide.vigem}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="{l:Tr guide.noWinget}"
                               Visibility="{Binding ShowNoWinget, Converter={x:Static g:BoolVisibility.Instance}}" />
                    <WrapPanel>
                        <Button Style="{StaticResource SkewButton}" Content="{l:Tr guide.install}" Command="{Binding InstallViGEmCommand}"
                                Visibility="{Binding ShowInstallViGEm, Converter={x:Static g:BoolVisibility.Instance}}" />
                        <Button Style="{StaticResource SkewButton}" Content="{l:Tr guide.download}" Command="{Binding DownloadViGEmCommand}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="{l:Tr guide.installing}"
                               Visibility="{Binding ShowInstalling, Converter={x:Static g:BoolVisibility.Instance}}" />
                    <TextBlock Foreground="{StaticResource Red}" Text="{Binding StepError}" TextWrapping="Wrap"
                               Visibility="{Binding StepError, Converter={x:Static g:TextVisibility.Instance}}" />
                    <Border Background="{StaticResource Strip}" BorderBrush="{StaticResource Warn}" BorderThickness="3,0,0,0" Padding="10,8" Margin="0,12,0,0"
                            Visibility="{Binding RestartNeeded, Converter={x:Static g:BoolVisibility.Instance}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SkewButton}" Content="{l:Tr guide.restart}" Command="{Binding RestartCommand}" Margin="12,0,0,0" />
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{l:Tr guide.restartText}" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- 2 HIDHIDE -->
                <StackPanel Visibility="{Binding Current, Converter={x:Static g:StepVisibility.Instance}, ConverterParameter=2}">
                    <TextBlock Style="{StaticResource Body}" Text="{l:Tr guide.hidhide}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="{l:Tr guide.noWinget}"
                               Visibility="{Binding ShowNoWinget, Converter={x:Static g:BoolVisibility.Instance}}" />
                    <WrapPanel>
                        <Button Style="{StaticResource SkewButton}" Content="{l:Tr guide.install}" Command="{Binding InstallHidHideCommand}"
                                Visibility="{Binding ShowInstallHidHide, Converter={x:Static g:BoolVisibility.Instance}}" />
                        <Button Style="{StaticResource SkewButton}" Content="{l:Tr guide.download}" Command="{Binding DownloadHidHideCommand}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="{l:Tr guide.installing}"
                               Visibility="{Binding ShowInstalling, Converter={x:Static g:BoolVisibility.Instance}}" />
                    <TextBlock Foreground="{StaticResource Red}" Text="{Binding StepError}" TextWrapping="Wrap"
                               Visibility="{Binding StepError, Converter={x:Static g:TextVisibility.Instance}}" />
                    <Border Background="{StaticResource Strip}" BorderBrush="{StaticResource Warn}" BorderThickness="3,0,0,0" Padding="10,8" Margin="0,12,0,0"
                            Visibility="{Binding RestartNeeded, Converter={x:Static g:BoolVisibility.Instance}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SkewButton}" Content="{l:Tr guide.restart}" Command="{Binding RestartCommand}" Margin="12,0,0,0" />
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{l:Tr guide.restartText}" />
                        </DockPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{l:Tr guide.rebootHint}" />
                </StackPanel>

                <!-- 3 CONFLITS -->
                <StackPanel Visibility="{Binding Current, Converter={x:Static g:StepVisibility.Instance}, ConverterParameter=3}">
                    <TextBlock Style="{StaticResource Body}" Text="{l:Tr guide.conflicts}" />
                    <Border Background="{StaticResource Tile}" Padding="12,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{l:Tr guide.running}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding ConflictsText}" Foreground="{StaticResource Red}" FontSize="14"
                                       Visibility="{Binding ConflictsText, Converter={x:Static g:TextVisibility.Instance}}" />
                            <TextBlock Text="{l:Tr guide.noConflict}" Foreground="{StaticResource Ok}" FontSize="14"
                                       Visibility="{Binding ConflictsText, Converter={x:Static g:TextVisibility.Instance}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 4 MANETTE -->
                <StackPanel Visibility="{Binding Current, Converter={x:Static g:StepVisibility.Instance}, ConverterParameter=4}">
                    <TextBlock Style="{StaticResource Body}" Text="{l:Tr guide.usb}" />
                    <TextBlock Style="{StaticResource Body}" Text="{l:Tr guide.bluetooth}" />
                    <Border Background="{StaticResource Tile}" Padding="12,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{l:Tr guide.connection}" />
                            <TextBlock Text="{Binding ConnectionText}" FontFamily="{StaticResource Display}" FontStyle="Oblique" FontWeight="SemiBold" FontSize="20" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Strip}" BorderBrush="{StaticResource Warn}" BorderThickness="3,0,0,0" Padding="10,8" Margin="0,12,0,0"
                            Visibility="{Binding ShowCableTip, Converter={x:Static g:BoolVisibility.Instance}}">
                        <TextBlock TextWrapping="Wrap" Text="{l:Tr guide.cableTip}" />
                    </Border>
                </StackPanel>

                <!-- 5 TEST -->
                <StackPanel Visibility="{Binding Current, Converter={x:Static g:StepVisibility.Instance}, ConverterParameter=5}">
                    <TextBlock Style="{StaticResource Body}" Text="{l:Tr guide.test}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Rectangle Style="{StaticResource CheckDot}" Tag="{Binding SawCross}" />
                        <TextBlock Style="{StaticResource CheckLine}" Text="{l:Tr guide.testCross}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Rectangle Style="{StaticResource CheckDot}" Tag="{Binding SawStick}" />
                        <TextBlock Style="{StaticResource CheckLine}" Text="{l:Tr guide.testStick}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Rectangle Style="{StaticResource CheckDot}" Tag="{Binding VirtualOk}" />
                        <TextBlock Style="{StaticResource CheckLine}" Text="{l:Tr guide.testVirtual}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Rectangle Style="{StaticResource CheckDot}" Tag="{Binding HiddenOk}" />
                        <TextBlock Style="{StaticResource CheckLine}" Text="{l:Tr guide.testHidden}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0" Text="{l:Tr guide.testHint}" />
                    <Border Background="{StaticResource Strip}" BorderBrush="{StaticResource Warn}" BorderThickness="3,0,0,0" Padding="10,8" Margin="0,12,0,0"
                            Visibility="{Binding RestartNeeded, Converter={x:Static g:BoolVisibility.Instance}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SkewButton}" Content="{l:Tr guide.restart}" Command="{Binding RestartCommand}" Margin="12,0,0,0" />
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{l:Tr guide.restartText}" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- 6 TERMINÉ -->
                <StackPanel Visibility="{Binding Current, Converter={x:Static g:StepVisibility.Instance}, ConverterParameter=6}">
                    <TextBlock Style="{StaticResource Body}" Text="{l:Tr guide.done1}" />
                    <TextBlock Style="{StaticResource Body}" Text="{l:Tr guide.done2}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{l:Tr guide.steam}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
